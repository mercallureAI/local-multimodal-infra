FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04@sha256:ac55d124da4882b497f732d8dfd9a702d5447a5f29d08d56da6f64f0a1eb34bc AS builder

ARG ORT_CUDA_VERSION=12
RUN test "${ORT_CUDA_VERSION}" = "12"
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain 1.88.0 \
    && rustc --version \
    && cargo --version

COPY . .
# ONNX Runtime is loaded at run time (ort `load-dynamic`); --locked fixes all
# Cargo inputs.
RUN cargo build --locked --release -p local-cli --bin worker --features cuda

# The official ONNX Runtime 1.30.0 CUDA 12 build, pinned by digest.
ARG ORT_VERSION=1.30.0
ARG ORT_SHA256=f9886932ee7bb0b4d3fcab736a392d4ff5efaa0672b47f19f0cec03437cf64f1
RUN set -eux; \
    curl -fsSL -o /tmp/ort.tgz \
        "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-gpu_cuda12-${ORT_VERSION}.tgz"; \
    echo "${ORT_SHA256}  /tmp/ort.tgz" | sha256sum -c -; \
    mkdir -p /tmp/ort /ort-libs; \
    tar -xzf /tmp/ort.tgz -C /tmp/ort --strip-components=1; \
    cp -av /tmp/ort/lib/libonnxruntime.so* /tmp/ort/lib/libonnxruntime_providers_shared.so \
        /tmp/ort/lib/libonnxruntime_providers_cuda.so /ort-libs/

# Use Ubuntu 24.04 for both stages, keeping the runtime CUDA and cuDNN
# versions fixed.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04@sha256:ac55d124da4882b497f732d8dfd9a702d5447a5f29d08d56da6f64f0a1eb34bc

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/workdir/models

COPY --from=builder /app/target/release/worker /usr/local/bin/worker
COPY --from=builder /ort-libs/ /usr/local/lib/
COPY configs ./configs
# Every library must resolve, except the driver's libcuda.so.1, which the
# NVIDIA container runtime mounts when the container starts.
RUN set -eux; \
    ldconfig; \
    test -x /usr/local/bin/worker; \
    for file in \
        /usr/local/bin/worker \
        /usr/local/lib/libonnxruntime.so \
        /usr/local/lib/libonnxruntime_providers_shared.so \
        /usr/local/lib/libonnxruntime_providers_cuda.so; do \
        ldd "${file}" | tee /tmp/ldd.txt; \
        if grep 'not found' /tmp/ldd.txt | grep -v 'libcuda\.so\.1 '; then exit 1; fi; \
    done

ENV ORT_DYLIB_PATH=/usr/local/lib/libonnxruntime.so
ENV RUST_LOG=info
